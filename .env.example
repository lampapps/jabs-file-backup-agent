# JABS Agent Environment Variables
# Copy this file to '.env' and fill in your values. '.env' is gitignored and
# will never be committed.

# This will display a banner, create a seperate monitor json file, and enable debug logging
# Uncomment the following line if codebase is in development mode
# ENV_MODE='development'

# URL:PORT for the JABS Dashboard, if used.
JABS_DASHBOARD_URL="http://your-jabs-dashboard:5001"

# Uptime Kuma push-monitor URL, if used. Pinged every time scheduler.py runs
# a check (typically every 15 minutes via cron) so a stopped scheduler is
# caught immediately. Leave empty to disable.
UPTIME_KUMA_URL=""

# API key for this agent, generated on the dashboard's Hosts page (Regenerate
# there if this ever needs to be rotated).
JABS_AGENT_KEY=""

# Encryption passphrase for backup encryption (required if encryption is enabled)
JABS_ENCRYPT_PASSPHRASE=""

# AWS credentials (used for S3 sync)
# These will be used instead of the AWS CLI profile configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SMTP credentials (for email notifications)
JABS_SMTP_PASSWORD=""
JABS_SMTP_USERNAME=""
